# ========================================
# PDF Summarizer - Environment Configuration
# ========================================

# ========================================
# LangChain Framework Configuration
# ========================================
# The application uses LangChain for LLM orchestration, document processing,
# embeddings, and vector store integration.

# Google AI API Configuration
# Required for: LangChain GoogleGenerativeAIEmbeddings & ChatGoogleGenerativeAI
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# LLM Configuration (used by LangChain LLM wrapper)
# Options: "gemini" or "ollama"
# - "gemini": Uses langchain_google_genai.ChatGoogleGenerativeAI
# - "ollama": Uses langchain_community.llms.Ollama
LLM_PROVIDER=gemini

# Google Gemini Model (if using Gemini via LangChain)
# Used with ChatGoogleGenerativeAI
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (if using Ollama via LangChain)
# Used with langchain_community.llms.Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Configuration (LangChain GoogleGenerativeAIEmbeddings)
# Model for text-to-vector conversion via LangChain embeddings wrapper
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=pdf_documents
QDRANT_DISTANCE_METRIC=cosine

# Text Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Configuration
TOP_K_CHUNKS=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your_secure_api_key_here
API_RATE_LIMIT=100  # requests per minute

# CORS Configuration
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Frontend Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Summary Configuration
BRIEF_SUMMARY_SENTENCES=5
DETAILED_SUMMARY_MIN_WORDS=300
DETAILED_SUMMARY_MAX_WORDS=500

# Token Tracking
MAX_CONTEXT_TOKENS=4000
TOKEN_TRACKING_ENABLED=true

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600  # 1 hour

# Database Retry Configuration
DB_MAX_RETRIES=3
DB_RETRY_DELAY=1  # seconds

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf"]

# Development/Production Mode
ENVIRONMENT=development  # Options: development, production
DEBUG=true
